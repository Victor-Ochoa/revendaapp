<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Package versions are added here as each project introduces a new dependency. -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Docker.SshDeploy" Version="0.1.0-ci.153" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.PostgreSQL.Extensions" Version="13.6.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <!-- Pin do MessagePack (transitivo via Aspire.Hosting) para a versão patcheada
         de GHSA-qhrr-8q5h-9q3h (CVE-2026-92707, moderada): 2.5.302 é vulnerável,
         2.5.303 corrige. Sem o pin, NU1902 quebrava o restore do AppHost (CI).
         Subido para 2.5.307 na atualização do Aspire 13.6.4, que passou a exigir
         MessagePack >= 2.5.307 (NU1109/downgrade com o pin antigo). -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- Pin do SSH.NET (transitivo via Aspire.Hosting.Docker.SshDeploy) para a versão que
         corrige GHSA-mggc-4xg6-vcxf (RCE via SCP) e GHSA-q939-rpr3-3284 (path traversal):
         2025.1.0 é vulnerável, 2026.0.0 corrige as duas. Mantém o deploy remoto SSH ativo. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Chaves de Data Protection persistidas no Postgres (tabela DataProtectionKeys). A versão
         acompanha a linha do EF Core do solution (10.0.14): esta package exige
         Microsoft.EntityFrameworkCore >= 10.0.14 e Microsoft.AspNetCore.DataProtection >= 10.0.14,
         então sobe junto com a família do EF Core em vez de ficar para trás. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <!-- Pin dos pacotes de criptografia transitivos via Microsoft.AspNetCore.DataProtection.
         A versão acompanha a linha 10.0.14 do EF Core/Data Protection: o Data Protection 10.0.14
         puxa System.Security.Cryptography.Xml >= 10.0.14, então os dois pins ficam em 10.0.14 para
         não reabrir NU1605 (downgrade) nem o gate de auditoria do restore (NU1902 vira erro com
         TreatWarningsAsErrors). Os advisories de DoS da linha 10.0.11 (GHSA-2fmv-rv2c-59x7,
         GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83) seguem
         corrigidos. Efeito REAL e único do pin: satisfazer o gate de auditoria do restore. NÃO é
         mitigação de runtime: esses assemblies vêm do shared framework Microsoft.AspNetCore.App,
         então em execução resolvem pela versão do framework, não pela do pacote — a correção
         efetiva exige subir a imagem do runtime do ASP.NET Core, que é assunto separado. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>