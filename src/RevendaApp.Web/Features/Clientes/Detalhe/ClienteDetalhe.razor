@page "/clientes/{ClienteId:guid}"
@attribute [Authorize(Policy = RevendaApp.Web.Common.Authorization.Politicas.ApenasEmpresa)]
@rendermode InteractiveServer

@using RevendaApp.Domain.Enums
@using RevendaApp.Web.Common
@using RevendaApp.Web.Common.Authorization
@using RevendaApp.Web.Features.Clientes.Detalhe
@using RevendaApp.Web.Features.Clientes.Emprestimos
@using RevendaApp.Web.Features.Clientes.Pagar
@using RevendaApp.Web.Features.Estoque.Listar
@using RevendaApp.Web.Features.Estoque.Vasilhames
@using RevendaApp.Web.Features.Home
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IUsuarioAutenticado UsuarioAutenticado
@inject IdentidadeEmpresaService Identidade

<PageTitle>@Identidade.Titulo("Cliente")</PageTitle>

@if (_carregando)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_cliente is null)
{
    <MudAlert Severity="MudBlazor.Severity.Warning">Cliente não encontrado.</MudAlert>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">@_cliente.Nome</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-4">Dados do cliente</MudText>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
                }

                <MudTextField T="string" @bind-Value="_nome" Label="Nome" Variant="Variant.Outlined" Class="mb-4" Required="true" />
                <MudMask @bind-Value="_telefone" Label="Telefone" Mask="@MascaraTelefoneMask" Variant="Variant.Outlined" Class="mb-4" Required="true" HelperText="Inclua o DDD — identifica o cliente" />
                <MudTextField T="string" @bind-Value="_endereco" Label="Endereço" Variant="Variant.Outlined" Class="mb-4" Required="true" />

                <MudText Typo="Typo.subtitle1" Class="mb-4">
                    Saldo devedor:
                    <MudText Typo="Typo.subtitle1" Color="@(_cliente.SaldoDevedor > 0 ? Color.Error : Color.Success)" Inline="true">
                        @_cliente.SaldoDevedor.ToString("C")
                    </MudText>
                </MudText>

                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync" Disabled="_salvando">
                        Salvar alterações
                    </MudButton>
                    @if (_cliente.SaldoDevedor > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments" OnClick="AbrirModalPagamento">
                            Receber pagamento
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Text" Href="/clientes">Voltar</MudButton>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-4">Histórico de compras</MudText>

                @if (_cliente.HistoricoDeCompras.Count == 0)
                {
                    <MudText>Nenhuma compra registrada ainda.</MudText>
                }
                else
                {
                    <MudTable T="VendaHistoricoItem" Items="_cliente.HistoricoDeCompras" Dense="true" Hover="true"
                              OnRowClick="@(e => AbrirDetalheVendaAsync(e.Item))">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Pagamento</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Entrega</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh>Lucro</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data">@context.DataHora.ToString("dd/MM/yyyy HH:mm")</MudTd>
                            <MudTd DataLabel="Pagamento">@context.FormaPagamento.Rotulo()</MudTd>
                            <MudTd DataLabel="Status">@context.Status.Rotulo()</MudTd>
                            <MudTd DataLabel="Entrega">@context.ValorEntrega.ToString("C")</MudTd>
                            <MudTd DataLabel="Total">@context.ValorTotal.ToString("C")</MudTd>
                            <MudTd DataLabel="Lucro">@context.LucroTotal.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <MudText Typo="Typo.h6" Class="mb-4 mt-6">Próxima recompra</MudText>

                @if (_cliente.Recompras.Count == 0)
                {
                    <MudText>Nenhum produto com aviso de recompra.</MudText>
                }
                else
                {
                    <MudList T="RecompraClienteItem" Dense="true">
                        @foreach (var recompra in _cliente.Recompras)
                        {
                            <MudListItem T="RecompraClienteItem">
                                <MudText Typo="Typo.body1"><strong>@recompra.ProdutoNome</strong></MudText>
                                <MudText Typo="Typo.caption" Color="@(recompra.DiasDecorridos >= 0 ? Color.Warning : Color.Default)">
                                    @if (recompra.DiasDecorridos >= 0)
                                    {
                                        <text>Data prevista vencida há @recompra.DiasDecorridos dia(s). Próxima em ~@((int)recompra.IntervaloMedioDias) dias.</text>
                                    }
                                    else
                                    {
                                        <text>Próxima compra em ~@((int)recompra.IntervaloMedioDias) dias (previsão @recompra.DataPrevista.ToString("dd/MM/yyyy")).</text>
                                    }
                                </MudText>
                            </MudListItem>
                        }
                    </MudList>
                }

                <MudText Typo="Typo.h6" Class="mb-4 mt-6">Produtos comprados</MudText>

            @if (_cliente.ProdutosComprados.Count == 0)
            {
                <MudText>Nenhum produto comprado ainda.</MudText>
            }
            else
            {
                <MudTable Items="_cliente.ProdutosComprados" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Produto</MudTh>
                        <MudTh>Quantidade</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Produto">@context.ProdutoNome</MudTd>
                        <MudTd DataLabel="Quantidade">@context.QuantidadeTotal</MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudText Typo="Typo.h6" Class="mb-4 mt-6">Histórico de pagamentos</MudText>

                @if (_cliente.HistoricoDePagamentos.Count == 0)
                {
                    <MudText>Nenhum pagamento registrado ainda.</MudText>
                }
                else
                {
                    <MudTable Items="_cliente.HistoricoDePagamentos" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Forma</MudTh>
                            <MudTh>Valor</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data">@context.Data.ToString("dd/MM/yyyy HH:mm")</MudTd>
                            <MudTd DataLabel="Forma">@RotuloFormaPagamento(context.FormaPagamento)</MudTd>
                            <MudTd DataLabel="Valor">@context.Valor.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-6">
                <div class="d-flex align-center mb-4">
                    <MudText Typo="Typo.h6" Class="mb-0">Vasilhames emprestados</MudText>
                    <MudSpacer />
                    <MudTooltip Text="Apenas administradores" Disabled="_ehAdministrador">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Outbox"
                                   OnClick="AbrirRegistrarEmprestimoAsync" Disabled="!_ehAdministrador" Class="mr-2">
                            Registrar empréstimo
                        </MudButton>
                    </MudTooltip>
                    <MudTooltip Text="@(ClienteTemEmprestimo ? "Apenas administradores" : "Cliente sem empréstimo em aberto")" Disabled="_ehAdministrador && ClienteTemEmprestimo">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Inbox"
                                   OnClick="AbrirRegistrarDevolucaoAsync" Disabled="!_ehAdministrador || !ClienteTemEmprestimo">
                            Registrar devolução
                        </MudButton>
                    </MudTooltip>
                </div>

                @if (_cliente.Emprestimos.Count == 0)
                {
                    <MudText>Nenhum vasilhame emprestado no momento.</MudText>
                }
                else
                {
                    <MudTable Items="_cliente.Emprestimos" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Produto</MudTh>
                            <MudTh>Quantidade</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Produto">@context.ProdutoNome</MudTd>
                            <MudTd DataLabel="Quantidade">@context.Quantidade</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudDialog @bind-Visible="_modalPagamentoAberto" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Receber pagamento — @_cliente?.Nome</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_pagamentoError))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_pagamentoError</MudAlert>
        }

        <MudText Class="mb-4">
            Saldo devedor atual:
            <MudText Typo="Typo.subtitle1" Color="Color.Error" Inline="true">@_cliente?.SaldoDevedor.ToString("C")</MudText>
        </MudText>

        <MudNumericField T="decimal" @bind-Value="_valorPagamento" Label="Valor a receber" Variant="Variant.Outlined"
                         Class="mb-4" Min="0.01m" Required="true" Adornment="Adornment.Start" AdornmentText="R$"
                         HelperText="@HelperValorPagamento" />
        <MudSelect T="FormaPagamento" @bind-Value="_formaPagamentoPagamento" Label="Forma de pagamento" Variant="Variant.Outlined" Class="mb-4">
            @foreach (var forma in _formasPagamentoPagamento)
            {
                <MudSelectItem T="FormaPagamento" Value="forma">@RotuloFormaPagamento(forma)</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="FecharModalPagamento">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmarPagamentoAsync" Disabled="_salvandoPagamento" StartIcon="@Icons.Material.Filled.Check">
            Confirmar pagamento
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Máscara de telefone com DDD aplicada ao campo de edição.</summary>
    private const string MascaraTelefone = "(00) 00000-0000";

    private static readonly MudBlazor.PatternMask MascaraTelefoneMask = new(MascaraTelefone);

    /// <summary>Helper do campo "Valor a receber": indica o teto (saldo devedor).</summary>
    private string HelperValorPagamento => $"Até o saldo devedor do cliente ({_cliente?.SaldoDevedor.ToString("C")})";

    [Parameter]
    public Guid ClienteId { get; set; }

    private ClienteDetalheResult? _cliente;
    private bool _carregando = true;
    private bool _ehAdministrador;
    private string _nome = "";
    private string _telefone = "";
    private string _endereco = "";
    private string? _errorMessage;
    private bool _salvando;

    private bool _modalPagamentoAberto;
    private decimal _valorPagamento;
    private FormaPagamento _formaPagamentoPagamento = FormaPagamento.Dinheiro;
    private string? _pagamentoError;
    private bool _salvandoPagamento;
    private IReadOnlyList<ProdutoListItem> _produtos = [];
    private bool _produtosCarregados;
    private static readonly FormaPagamento[] _formasPagamentoPagamento =
        Enum.GetValues<FormaPagamento>().Where(f => f != FormaPagamento.Fiado).ToArray();

    private IEnumerable<ProdutoListItem> ProdutosVasilhame => _produtos.Where(p => p.ControlaVasilhame);

    /// <summary>True quando o cliente tem ao menos um vasilhame emprestado em aberto (só então
    /// pode devolver). Usado para desabilitar o botão "Registrar devolução".</summary>
    private bool ClienteTemEmprestimo => _cliente?.Emprestimos.Count > 0;

    /// <summary>
    /// Produtos que o cliente tem emprestados em aberto — usados para restringir a modal de
    /// devolução ao que ele realmente pode devolver. Vazio quando não há empréstimo.
    /// </summary>
    private IReadOnlyList<EmprestimoClienteItem> EmprestimosDoCliente =>
        _cliente?.Emprestimos ?? [];

    /// <summary>Produto sugerido na abertura da modal de empréstimo (o do último empréstimo do
    /// cliente, senão o primeiro com controle). É apenas pré-seleção — o operador pode trocar.</summary>
    private ProdutoListItem? ProdutoVasilhameSugerido =>
        _cliente?.Emprestimos.Count > 0
            ? ProdutosVasilhame.FirstOrDefault(p => p.Id == _cliente.Emprestimos[0].ProdutoId)
            : ProdutosVasilhame.FirstOrDefault();

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _ehAdministrador = await UsuarioAutenticado.EhAdministradorAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _carregando = true;
        _cliente = await Sender.Send(new ObterClienteDetalheQuery(ClienteId));
        if (_cliente is not null)
        {
            _nome = _cliente.Nome;
            _telefone = _cliente.Telefone;
            _endereco = _cliente.Endereco;
        }

        _carregando = false;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            await Sender.Send(new AtualizarClienteCommand(ClienteId, _nome, _telefone, _endereco));
            _cliente = await Sender.Send(new ObterClienteDetalheQuery(ClienteId));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        finally
        {
            _salvando = false;
        }
    }

    private void AbrirModalPagamento()
    {
        _pagamentoError = null;
        _valorPagamento = 0;
        _formaPagamentoPagamento = FormaPagamento.Dinheiro;
        _modalPagamentoAberto = true;
    }

    private void FecharModalPagamento() => _modalPagamentoAberto = false;

    private async Task AbrirDetalheVendaAsync(VendaHistoricoItem? venda)
    {
        if (venda is null)
        {
            return;
        }

        var parameters = new DialogParameters<DetalheVendaDialog>
        {
            { x => x.VendaId, venda.VendaId },
        };

        await DialogService.ShowAsync<DetalheVendaDialog>("Detalhe da venda", parameters);
    }

    private async Task CarregarProdutosAsync()
    {
        if (_produtosCarregados)
        {
            return;
        }

        _produtos = await Sender.Send(new ListarProdutosQuery(IncluirInativos: true));
        _produtosCarregados = true;
    }

    private async Task AbrirRegistrarEmprestimoAsync()
    {
        await CarregarProdutosAsync();
        var parameters = new DialogParameters<RegistrarMovimentacaoVasilhameDialog>
        {
            // Produto sugerido (último empréstimo do cliente ou o primeiro da lista) — o operador
            // pode trocar na modal (select editável). Cliente sempre fixo nesta tela.
            { x => x.ProdutoId, ProdutoVasilhameSugerido?.Id ?? Guid.Empty },
        };

        if (_cliente is not null)
        {
            parameters.Add(x => x.ClienteIdInicial, _cliente.Id);
        }

        var dialog = await DialogService.ShowAsync<RegistrarMovimentacaoVasilhameDialog>("Registrar empréstimo", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await RecarregarClienteAsync();
        }
    }

    private async Task AbrirRegistrarDevolucaoAsync()
    {
        await CarregarProdutosAsync();
        var parameters = new DialogParameters<RegistrarMovimentacaoVasilhameDialog>
        {
            // Produto sugerido (último empréstimo do cliente ou o primeiro da lista) — o operador
            // pode trocar na modal (select editável). Cliente sempre fixo nesta tela.
            { x => x.ProdutoId, ProdutoVasilhameSugerido?.Id ?? Guid.Empty },
            { x => x.EhEmprestimo, false },
            // Devolução da tela do cliente: só os produtos que ele tem emprestado podem ser devolvidos.
            { x => x.ProdutosEmprestadosCliente, EmprestimosDoCliente.Select(e => e.ProdutoId).ToList() },
        };

        if (_cliente is not null)
        {
            parameters.Add(x => x.ClienteIdInicial, _cliente.Id);
        }

        var dialog = await DialogService.ShowAsync<RegistrarMovimentacaoVasilhameDialog>("Registrar devolução", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await RecarregarClienteAsync();
        }
    }

    private async Task RecarregarClienteAsync()
    {
        _cliente = await Sender.Send(new ObterClienteDetalheQuery(ClienteId));
    }

    private async Task ConfirmarPagamentoAsync()
    {
        if (_cliente is null)
        {
            return;
        }

        _salvandoPagamento = true;
        _pagamentoError = null;
        try
        {
            await Sender.Send(new RegistrarPagamentoCommand(
                _cliente.Id, _valorPagamento, _formaPagamentoPagamento));
            _modalPagamentoAberto = false;
            _cliente = await Sender.Send(new ObterClienteDetalheQuery(ClienteId));
        }
        catch (ValidationException ex)
        {
            _pagamentoError = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            // Conflito de concorrência (saldo alterado por outro pagamento): mostra a orientação de
            // recarregar e tentar novamente em vez de derrubar o circuito.
            _pagamentoError = ex.Message;
        }
        finally
        {
            _salvandoPagamento = false;
        }
    }

    private static string RotuloFormaPagamento(FormaPagamento forma) => forma.Rotulo();
}
